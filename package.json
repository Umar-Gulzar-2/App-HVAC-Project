{
  "name": "hvac-comply",
  "version": "1.0.0",
  "description": "HVAC Comply — a commercial HVAC equipment, refrigerant recordkeeping, and compliance attention app.",
  "main": "expo-router/entry",
  "license": "0BSD",
  "scripts": {
    "start": "expo start",
